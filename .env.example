# Optional. Set one of the two keys; without either, the agents use deterministic templates.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,openrouter/free
ANTHROPIC_API_KEY=
SECOND_LIFE_MODEL=claude-sonnet-5-5
# Path to JSONL patent data (see README for schema). Defaults to the bundled synthetic sample.
SECOND_LIFE_DATA=data/sample_patents.jsonl
SECOND_LIFE_DB=second_life.db
# Comma separated origins allowed to call the API from a browser UI.
CORS_ORIGINS=*
